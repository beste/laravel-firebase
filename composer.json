{
    "name": "kreait/laravel-firebase",
    "description": "A Laravel package for the Firebase PHP Admin SDK",
    "keywords": ["laravel", "firebase", "firebase", "sdk", "api", "database", "fcm", "gcm"],
    "type": "library",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Jérôme Gamez",
            "email": "jerome@gamez.name"
        }
    ],
    "repositories": [
        {
            "name": "kreait/firebase-php",
            "type": "vcs",
            "url": "https://github.com/StuDocu/firebase-php.git"
        }
    ],
    "require": {
        "php": "^8.3.0",
        "kreait/firebase-php": "dev-7.1-studocu",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "symfony/cache": "^6.1.2 || ^7"
    },
    "require-dev": {
        "orchestra/testbench": "^7.0 || ^8.0 || ^9.0 || ^10.4 || ^11.0",
        "laravel/pint": "^1.14",
        "phpunit/phpunit": "^9.6.17 || ^10.5.13 || ^12.5.17 || ^13.1.1"
    },
    "autoload": {
        "psr-4": {
            "Kreait\\Laravel\\Firebase\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kreait\\Laravel\\Firebase\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kreait\\Laravel\\Firebase\\ServiceProvider"
            ],
            "aliases": {
                "Firebase": "Kreait\\Laravel\\Firebase\\Facades\\Firebase"
            }
        }
    },
    "scripts": {
        "cs": [
            "vendor/bin/pint"
        ],
        "test": [
            "vendor/bin/phpunit"
        ]
    }
}
